rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // INNTEL CORP S.A. - Reglas de Ciberseguridad & Control de Acceso
    // Denegación por defecto: cualquier ruta no declarada explícitamente es inaccesible.

    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Registro Forense e Incidentes: Estrictamente INMUTABLE (WORM)
    // Solo lectura y creación por usuarios autenticados; prohibida modificación y eliminación.
    match /auditLogs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /securityIncidents/{incidentId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 2. Colecciones Críticas: Prohibidas para clientes web directos (Solo Admin SDK / Backend)
    match /users/{userId} {
      allow read, write: if false;
    }
    match /vault/{vaultId} {
      allow read, write: if false;
    }
    match /clientVaultItems/{itemId} {
      allow read, write: if false;
    }

    // 3. Colecciones Operativas: Requieren sesión activa autenticada
    match /clients/{clientId} {
      allow read, write: if isAuthenticated();
    }
    match /nodes/{nodeId} {
      allow read, write: if isAuthenticated();
    }
    match /tickets/{ticketId} {
      allow read, write: if isAuthenticated();
    }
    match /plans/{planId} {
      allow read, write: if isAuthenticated();
    }
    match /ipPools/{poolId} {
      allow read, write: if isAuthenticated();
    }
    match /clientProjects/{projectId} {
      allow read, write: if isAuthenticated();
    }
    match /clientQuotes/{quoteId} {
      allow read, write: if isAuthenticated();
    }
    match /clientContracts/{contractId} {
      allow read, write: if isAuthenticated();
    }
    match /charges/{chargeId} {
      allow read, write: if isAuthenticated();
    }
    match /suppliers/{supplierId} {
      allow read, write: if isAuthenticated();
    }
    match /purchaseInvoices/{invoiceId} {
      allow read, write: if isAuthenticated();
    }
    match /purchaseWithholdings/{withholdingId} {
      allow read, write: if isAuthenticated();
    }
    match /supplierCreditNotes/{noteId} {
      allow read, write: if isAuthenticated();
    }
    match /supplierDebitNotes/{noteId} {
      allow read, write: if isAuthenticated();
    }
    match /bankAccounts/{accountId} {
      allow read, write: if isAuthenticated();
    }
    match /financialMovements/{movementId} {
      allow read, write: if isAuthenticated();
    }
    match /supplierPayments/{paymentId} {
      allow read, write: if isAuthenticated();
    }
    match /sriCompanyConfig/{configId} {
      allow read, write: if isAuthenticated();
    }
    match /hostingDomains/{domainId} {
      allow read, write: if isAuthenticated();
    }
    match /regulatoryTramites/{tramiteId} {
      allow read, write: if isAuthenticated();
    }
    match /systemConfig/{configId} {
      allow read, write: if isAuthenticated();
    }
    match /inventoryItems/{itemId} {
      allow read, write: if isAuthenticated();
    }
    match /inventoryKardex/{kardexId} {
      allow read, write: if isAuthenticated();
    }
    match /warehouses/{warehouseId} {
      allow read, write: if isAuthenticated();
    }
  }
}
