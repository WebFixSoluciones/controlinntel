rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated INNTEL operators can access data
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }
    
    match /{entity}/{id} {
      allow read, write: if request.auth != null;
    }
    
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
