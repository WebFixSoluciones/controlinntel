rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // INNTEL CORP S.A. - Control Operativo ISP & ARCOTEL
    // Permite lectura y escritura para la sincronización operativa de clientes, red y contratos
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
