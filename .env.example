# Public Firebase web configuration (not Firebase Admin credentials).
# Defaults in src/lib/firebase.ts target the INNTEL project.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDPRZzOnooech-TcUqEunt0NATaHnxpSzY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=inntelcorp-45c89.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=inntelcorp-45c89
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=inntelcorp-45c89.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=495714041690
NEXT_PUBLIC_FIREBASE_APP_ID=1:495714041690:web:f67df905e09e7cd442fd63
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-4DDGPRZJZK

# Required server credentials: use secret environment variables, never NEXT_PUBLIC_*.
FIREBASE_PROJECT_ID=inntelcorp-45c89
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# Or GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
# VAULT_KEY_BASE64=base64-of-32-random-bytes
# Sin esa variable, el servidor lee esta versión fija de Google Secret Manager.
# VAULT_KEY_SECRET_VERSION=projects/your-project/secrets/inntel-vault-key/versions/1
# Nunca cambies la clave sin migrar antes las credenciales cifradas existentes.
# Opcional: proveedor de teselas y atribución pública correspondiente.
# NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=Copyright OpenStreetMap contributors
# Optional delivery adapter; must return {"messageId":"provider-reference"}.
# EMAIL_DELIVERY_WEBHOOK_URL=https://your-mail-adapter.example/send
# EMAIL_DELIVERY_WEBHOOK_TOKEN=server-secret
# Archivos nuevos: depósito privado de Google Cloud Storage con las credenciales del servidor.
# Valor predeterminado: <FIREBASE_PROJECT_ID>-documents. Aprovisionar antes del despliegue.
# DOCUMENTS_BUCKET=your-project-documents
# Solo para descargar o eliminar archivos del almacenamiento Vercel anterior:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Local QA only, with an isolated demo project and Firebase emulators.
NEXT_PUBLIC_USE_EMULATORS=false
